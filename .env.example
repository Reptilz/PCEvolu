# Copie ce fichier en .env et renseigne l'adresse publique du fichier de prix
# (une fois le dépôt GitHub créé). L'app la télécharge au démarrage.
VITE_PRICES_URL=https://raw.githubusercontent.com/COMPTE/DEPOT/main/data/prices.json

# Uniquement pour lancer « npm run prices » sur ce PC (ne jamais publier ce fichier) :
SERPER_API_KEY=
